<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="370dp"
    android:layout_height="130dp"
    android:layout_marginHorizontal="20dp"
    android:padding="14dp"
    android:background="@drawable/widget_bg">
    <!---->

    <ImageView
        android:id="@+id/ivInventoryImage"
        android:layout_width="70dp"
        android:layout_height="70dp"
        android:layout_alignParentStart="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="2dp"
        android:layout_marginStart="10dp"
        android:contentDescription="@string/inventory_image"
        android:src="@drawable/ic_inventory" />

    <TextView
        android:id="@+id/tvNameAppWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/ivInventoryImage"
        android:layout_alignParentStart="true"
        android:layout_marginStart="5dp"
        android:layout_marginTop="5dp"
        android:text="@string/inventory"
        android:textColor="@color/orange_dark"
        android:textSize="18sp"
        android:textStyle="bold" />


    <TextView
        android:id="@+id/tvTopTextWidget"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/btnEyeWidget"
        android:layout_toEndOf="@+id/ivInventoryImage"
        android:text="@string/top_text_widget"
        android:textColor="@android:color/white"
        android:textSize="15sp"
        android:textStyle="bold" />

    <ImageView
        android:id="@+id/btnEyeWidget"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:src="@drawable/eye"
        android:contentDescription="@string/eye_widget"
        android:layout_alignParentTop="true"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="2dp"
        />

    <TextView
        android:id="@+id/tvSaldoTotal"
        android:text="$ * * * *"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        android:textAlignment="textEnd"
        android:layout_width="200dp"
        android:layout_height="wrap_content"
        android:layout_below="@id/btnEyeWidget"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"/>


    <TextView
        android:id="@+id/tvGestionarInventario"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tvSaldoTotal"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/btnGearWidget"
        android:text="@string/gestionar_inventario"
        android:textColor="@android:color/white"
        android:textSize="18sp" />

    <ImageView
        android:id="@+id/btnGearWidget"
        android:layout_width="25dp"
        android:layout_height="25dp"
        android:src="@drawable/gear"
        android:contentDescription="@string/boton_gestionar_inventario"
        android:layout_below="@id/tvSaldoTotal"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="12dp"/>
</RelativeLayout>