<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/loginFragment">

    <!-- 🔐 Pantalla de Login -->
    <fragment
        android:id="@+id/loginFragment"
        android:name="com.univalle.equipotres.view.fragment.LoginFragment"
        android:label="LoginFragment"
        tools:layout="@layout/fragment_login">

        <action
            android:id="@+id/action_loginFragment_to_homeFragment"
            app:destination="@id/homeFragment"
            app:popUpTo="@id/loginFragment"
            app:popUpToInclusive="true" />
    </fragment>

    <!-- 🏠 Pantalla principal (Home) -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.univalle.equipotres.view.fragment.HomeFragment"
        android:label="HomeFragment"
        tools:layout="@layout/fragment_home">

        <action
            android:id="@+id/action_homeFragment_to_loginFragment"
            app:destination="@id/loginFragment"
            app:popUpTo="@id/homeFragment"
            app:popUpToInclusive="true" />

        <action
            android:id="@+id/action_homeFragment_to_itemDetailFragment"
            app:destination="@id/itemDetailFragment"/>
      
        <action
            android:id="@+id/action_homeFragment_to_addProductFragment"
            app:destination="@id/addProductFragment"
            app:enterAnim="@android:anim/slide_in_left"
            app:exitAnim="@android:anim/slide_out_right"
            app:popEnterAnim="@android:anim/slide_in_left"
            app:popExitAnim="@android:anim/slide_out_right" />
            app:destination="@id/itemDetailFragment" />
}
    </fragment>

    <!-- 🔍 Detalle del producto -->
    <fragment
        android:id="@+id/itemDetailFragment"
        android:name="com.univalle.equipotres.view.fragment.ItemDetailFragment"
        android:label="ItemDetailFragment"
        tools:layout="@layout/fragment_item_detail">

        <!-- Acción para volver al Home -->

        <action
            android:id="@+id/action_item_detail_to_homeFragment"
            app:destination="@id/homeFragment" />

        <!-- Acción para ir a la edición -->
        <action
            android:id="@+id/action_item_detail_to_editProductFragment"
            app:destination="@id/editProductFragment" />

        <!-- Argumento que se pasa al editar -->
        <argument
            android:name="product"
            app:argType="com.univalle.equipotres.model.Product" />
    </fragment>

    <!-- ✏️ Editar producto -->
    <fragment
        android:id="@+id/editProductFragment"
        android:name="com.univalle.equipotres.view.fragment.EditProductFragment"
        android:label="EditProductFragment"
        tools:layout="@layout/fragment_edit_product">

        <argument
            android:name="product"
            app:argType="com.univalle.equipotres.model.Product" />

        <!-- Acción opcional para volver al Home -->
        <action
            android:id="@+id/action_editProductFragment_to_homeFragment"
            app:destination="@id/homeFragment" />
    </fragment>

    <fragment
        android:id="@+id/addProductFragment"
        android:name="com.univalle.equipotres.view.fragment.AddProductFragment"
        android:label="AddProductFragment"
        tools:layout="@layout/fragment_add_product">

    </fragment>

</navigation>
